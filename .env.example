# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
BRAINTRUST_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=
# Server-side only: this key bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

BRAINTRUST_PROJECT=E-commerce Support Agent

# Per 1M input/output tokens: Opus $4/$20, Sonnet $2/$10, Haiku $0.10/$0.50.
AGENT_MODEL=claude-sonnet-5-5
SIMULATOR_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5

# Pin a Braintrust prompt version. Empty means the latest version.
PROMPT_VERSION=

# Baseline demo: leave false. Set to true (or pass --healing) to enable runtime recovery.
RUNTIME_HEALING=false
# Probability from 0 to 1 that a tool call fails with an injected transient error.
FAULT_RATE=0
